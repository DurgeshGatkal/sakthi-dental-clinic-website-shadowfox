{
  "extends": "../tsconfig.base.json",
  "include": ["app/**/*", "*.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "types": ["vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true
  }
}
