# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000

# Database — MongoDB Atlas free M0 cluster (section 17)
# Used by `npm run dev` and by the deployed API. `npm run dev:local` ignores it
# and starts a local mongod instead, which is what day-to-day work uses.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sakthi_dev?retryWrites=true&w=majority

# CORS allow-list: production domain, Vercel previews, localhost (section 11)
CORS_ORIGINS=http://localhost:5173

# Contact-form email notifications (section 11)
# Showcase build: left off on purpose — the address on the site is display copy
# with no mailbox behind it. Set MAIL_ENABLED=true only when a real inbox exists.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=info@sakthidentalclinic.in

# Salt for hashing the submitter's IP; never store the raw IP (section 15)
IP_HASH_SALT=replace-with-a-long-random-string
