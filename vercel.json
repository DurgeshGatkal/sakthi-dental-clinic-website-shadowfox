{
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "client/build/client",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api" },
    { "source": "/api/v1", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
